# Server-side Apps Script web-app URL. Never expose this in frontend files.
APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec

# Server-side token configured separately in Apps Script project properties.
JOBSPY_IMPORT_TOKEN=replace-with-a-long-random-token

# Admin authentication. Prefer a Werkzeug-generated password hash.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-a-werkzeug-password-hash
SECRET_KEY=replace-with-a-long-random-session-secret

# Exact browser origins allowed to call the API.
ALLOWED_ORIGINS=https://antokochumon.github.io
SESSION_COOKIE_SECURE=1

# Optional search/collector settings.
JOBSPY_SEARCH_SITES=indeed,glassdoor
JOBSPY_SITES=indeed
SEARCH_LOCATIONS=England,Scotland,Wales,Northern Ireland
RESULTS_PER_SEARCH=15
MAX_SEARCHES_PER_RUN=20
MAX_AGE_DAYS=28
REQUEST_DELAY_SECONDS=2
